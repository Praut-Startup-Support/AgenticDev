#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  agenticdev-ctl — obsluha platformy na VPS
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

ROOT=/srv/agenticdev
ENVF=$ROOT/config/.env
SRC=$ROOT/src

B='\033[1;36m'; G='\033[1;32m'; Y='\033[1;33m'; R='\033[1;31m'; D='\033[2m'; O='\033[0m'
die(){ printf "${R}✗ %s${O}\n" "$*" >&2; exit 1; }

[[ -r $ENVF ]] || die "platforma není nainstalovaná ($ENVF chybí)"
# shellcheck disable=SC1090
set -a; . $ENVF; set +a

# gate = runner brány před mergem; public = Caddy s doménou
PROFILE=(--profile gate)
[[ "${AGENTICDEV_MODE:-tailnet}" == "public" ]] && PROFILE+=(--profile public)
dc() { (cd "$SRC/vps" && docker compose "${PROFILE[@]}" --env-file "$ENVF" "$@"); }

case "${1:-status}" in

  status)
    printf "\n${B}▸ Služby${O}\n"; dc ps
    printf "\n${B}▸ Control plane${O}\n"
    curl -fsS "http://${VPS_HOST}:8080/v1/health" 2>/dev/null || echo "  nedostupný"
    echo
    printf "\n${B}▸ Porty zvenčí${O} ${D}(má být jen 22, 80, 443)${O}\n"
    ss -tlnp 2>/dev/null | awk 'NR==1 || /0\.0\.0\.0|\[::\]/' || true
    ;;

  up)      dc up -d --build ;;
  down)    dc down ;;
  restart) dc restart "${2:-}" ;;
  logs)    dc logs -f --tail=200 "${2:-}" ;;
  pull)    dc pull && dc up -d --build ;;

  info)    agenticdev-info ;;

  mac)
    printf "\n${B}▸ Generuji instalátor Macu${O}\n"
    f=$(bash "$SRC/vps/mk-mac-installer.sh")
    printf "${G}  ✓ %s${O}\n\n" "$f"
    printf "  Přenes ho na Mac:\n    ${Y}scp root@%s:%s ~/Downloads/${O}\n" "${VPS_HOST}" "$f"
    printf "  a tam spusť:\n    ${Y}bash ~/Downloads/agenticdev-install-mac.sh${O}\n\n"
    ;;

  user)
    # Pody běží na VPS (ADR-0005), takže každý člověk potřebuje na serveru
    # vlastní účet: vlastní ~/.pi/agent s přihlášením k modelu a vlastní
    # sessions. Privilegovanou část dělá root tady, jednou na člověka.
    [[ $EUID -eq 0 ]] || die "tohle musí root: sudo agenticdev-ctl user $*"
    case "${2:-}" in
      add)
        LOGIN="${3:-}"
        [[ -n "$LOGIN" ]] || die "použití: agenticdev-ctl user add <login> [\"Jméno Příjmení\"] [e-mail]"
        [[ "$LOGIN" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || die "login smí být jen malá písmena, číslice, - a _"
        FULL="${4:-$LOGIN}"
        MAIL="${5:-$LOGIN@$(hostname -f 2>/dev/null || hostname)}"

        if id "$LOGIN" >/dev/null 2>&1; then
          printf "${Y}  !${O} účet %s už existuje, jen ho dorovnám\n" "$LOGIN"
        else
          useradd -m -s /bin/bash "$LOGIN" || die "účet se nepodařilo založit"
          printf "${G}  ✓${O} účet %s\n" "$LOGIN"
        fi

        # Bez skupiny docker nespustí pod. Je to zároveň to nejcitlivější
        # místo celého návrhu — viz varování na konci.
        getent group docker >/dev/null && usermod -aG docker "$LOGIN"

        HOME_DIR=$(getent passwd "$LOGIN" | cut -d: -f6)
        install -d -m 0700 -o "$LOGIN" -g "$LOGIN" "$HOME_DIR/.agenticdev"
        install -d -m 0700 -o "$LOGIN" -g "$LOGIN" "$HOME_DIR/.pi" "$HOME_DIR/.pi/agent"

        # Device key té osoby. Identita v ledgeru je člověk na tomhle VPS,
        # ne notebook — pody už na notebooku neběží.
        KEYF="$HOME_DIR/.agenticdev/device.key"
        if [[ ! -f "$KEYF" ]]; then
          sudo -u "$LOGIN" ssh-keygen -q -t ed25519 -N '' -C "agenticdev-$LOGIN" -f "$KEYF"
        fi
        FP=$(ssh-keygen -lf "$KEYF.pub" | awk '{print $2}')

        # SSH klíč do Forgeja, ať funguje git clone bez ptaní.
        SSHK="$HOME_DIR/.ssh/id_ed25519"
        if [[ ! -f "$SSHK" ]]; then
          install -d -m 0700 -o "$LOGIN" -g "$LOGIN" "$HOME_DIR/.ssh"
          sudo -u "$LOGIN" ssh-keygen -q -t ed25519 -N '' -C "$LOGIN@agenticdev" -f "$SSHK"
        fi

        cat > "$HOME_DIR/.agenticdev/config" <<CFGEOF
CONTROL_PLANE=http://${VPS_HOST}:8080
DEVICE_KEY_FP=$FP
HOSTNAME_=$LOGIN@$(hostname -s 2>/dev/null || hostname)
CFGEOF
        chown "$LOGIN:$LOGIN" "$HOME_DIR/.agenticdev/config"
        chmod 600 "$HOME_DIR/.agenticdev/config"

        RESP=$(curl -fsS -X POST "http://${VPS_HOST}:8080/v1/workstations/register" \
          -H 'content-type: application/json' \
          -d "$(jq -nc --arg t "$JOIN_TOKEN" --arg h "$LOGIN@$(hostname -s 2>/dev/null || hostname)" \
                --arg f "$FP" --arg n "$FULL" --arg e "$MAIL" \
                --arg k "$(cat "$SSHK.pub")" \
                '{join_token:$t,hostname:$h,device_key_fp:$f,display_name:$n,email:$e,ssh_public_key:$k}')" \
          2>/dev/null) || die "registrace u control plane selhala"
        jq -e .workstation_id >/dev/null <<<"$RESP" || die "server odmítl: $RESP"
        printf "${G}  ✓${O} zaregistrováno jako %s <%s>\n" "$FULL" "$MAIL"
        jq -e '.git_ready == true' >/dev/null <<<"$RESP" \
          && printf "${G}  ✓${O} SSH klíč ve Forgeju\n" \
          || printf "${Y}  !${O} SSH klíč se do Forgeja nedostal (chybí FORGEJO_TOKEN?)\n"

        printf "\n  Pošli tomu člověku:\n"
        printf "    ${Y}tailscale ssh %s@%s${O}\n" "$LOGIN" "$(hostname -s 2>/dev/null || hostname)"
        printf "    ${Y}agenticdev${O}\n"
        printf "  ${D}Poprvé se v Pi přihlásí k modelu přes /login. Platí to pak dál.${O}\n"
        printf "\n  ${Y}Pozor:${O} členství ve skupině docker je na tomhle stroji\n"
        printf "  ${D}rovnocenné rootovi — ten člověk si přečte i %s.${O}\n\n" "$ENVF"
        ;;
      pending)
        printf "\n${B}▸ Ohlásili se a čekají na účet${O}\n"
        psql_out=$(dc exec -T postgres psql -qtAX -U agenticdev -d agenticdev -c \
          "SELECT first_name||' '||last_name||E'\t'||email||E'\t'||coalesce(os,'-')
             FROM enrollment WHERE claimed_at IS NULL ORDER BY created_at DESC LIMIT 50" 2>/dev/null)
        if [[ -z "$psql_out" ]]; then
          printf "  ${D}nikdo${O}\n\n"
        else
          printf '%s\n' "$psql_out" | while IFS=$'\t' read -r who mail os_; do
            printf "  %-24s %-28s ${D}%s${O}\n" "$who" "$mail" "$os_"
            printf "    ${Y}agenticdev-ctl user add %s \"%s\" %s${O}\n" \
              "$(printf '%s' "${mail%%@*}" | tr -cd 'a-z0-9' | cut -c1-31)" "$who" "$mail"
          done
          echo
        fi
        ;;
      list)
        printf "\n${B}▸ Lidé s účtem na VPS${O}\n"
        for h in /home/*; do
          [[ -f "$h/.agenticdev/config" ]] || continue
          printf "  %-16s %s\n" "$(basename "$h")" \
            "$(grep -m1 '^DEVICE_KEY_FP=' "$h/.agenticdev/config" | cut -d= -f2-)"
        done
        echo
        ;;
      *) die "použití: agenticdev-ctl user add <login> [\"Jméno Příjmení\"] [e-mail] | user list | user pending" ;;
    esac
    ;;

  funnel)
    # Zvenčí smí být vidět jedna jediná cesta — registrace. Funnel jede
    # na 8443, aby si nelezl do cesty s Caddy na 443.
    printf "\n${B}▸ Veřejná registrace${O}\n"
    if ! tailscale funnel --bg --https=8443 "http://${VPS_HOST}:8080/join"; then
      printf "${R}  ✗ Funnel se nezapnul${O}\n"
      echo "    Uzel potřebuje v ACL atribut funnel:"
      echo "    https://login.tailscale.com/admin/acls → Funnel → Add Funnel to policy"
      exit 1
    fi
    TS_NAME=$(tailscale status --json 2>/dev/null \
              | grep -oE '"DNSName"[[:space:]]*:[[:space:]]*"[^"]+"' \
              | head -1 | sed 's/.*"\([^"]*\)"$/\1/' | sed 's/\.$//')
    [[ -n "$TS_NAME" ]] || die "nezjistil jsem veřejné jméno — 'tailscale funnel status'"
    URL="https://${TS_NAME}:8443/"
    if grep -q '^JOIN_URL=' "$ENVF"; then
      sed -i "s|^JOIN_URL=.*|JOIN_URL=$URL|" "$ENVF"
    else
      echo "JOIN_URL=$URL" >>"$ENVF"
    fi
    printf "${G}  ✓ %s${O}\n" "$URL"
    printf "  ${D}ověř zvenčí (ne z tailnetu):  curl %shealth${O}\n\n" "$URL"
    ;;

  smoke)
    (cd "$SRC" && bash tools/smoke-vps.sh "${@:2}")
    ;;

  backup-now)
    systemctl start agenticdev-backup.service
    journalctl -u agenticdev-backup.service -n 40 --no-pager
    ;;

  backup-check)
    [[ -n "${RESTIC_REPOSITORY:-}" ]] || die "zálohy nejsou nastavené (RESTIC_REPOSITORY)"
    restic snapshots | tail -20
    ;;

  gate)
    # Brána před mergem je jediná věc, která zastaví špatný kód od člověka,
    # který ho neumí přečíst. Tenhle příkaz existuje proto, že se z kódu
    # nedá vyčíst jedna podstatná věc: jak Forgejo pojmenovává commit
    # statusy. Požadovaný status, který se nikdy neobjeví, vypadá v panelu
    # jako fungující brána — a přitom drží merge zablokovaný navždycky.
    CODE="${2:-}"
    [[ -n "$CODE" ]] || die "použití: agenticdev-ctl gate <projekt> [--fix]"
    [[ -n "${DASHBOARD_TOKEN:-}" ]] || die "DASHBOARD_TOKEN v .env chybí"
    API="http://${VPS_HOST}:8080"
    JAR=$(mktemp)
    trap 'rm -f "$JAR"' EXIT

    curl -fsS -c "$JAR" -X POST "$API/v1/auth/dashboard" \
      -H 'content-type: application/json' \
      -d "$(python3 -c 'import json,sys;print(json.dumps({"token":sys.argv[1]}))' "$DASHBOARD_TOKEN")" \
      >/dev/null 2>&1 \
      || die "přihlášení k API selhalo — heslo do panelu se možná měnilo v panelu a .env má staré"

    if [[ "${3:-}" == "--fix" ]]; then
      printf "${B}▸${O} Nasazuji bránu znovu podle nastavení\n"
      curl -fsS -b "$JAR" -X POST "$API/v1/projects/$CODE/gate" \
        | python3 -c 'import json,sys; d=json.load(sys.stdin); print("  workflow:", d["workflow"], "· ochrana:", d["protection"], "· webhook:", d["webhook"]); print("  požaduje:", ", ".join(d["required_contexts"]))' \
        || die "nasazení selhalo"
      echo
    fi

    OUT=$(curl -fsS -b "$JAR" "$API/v1/projects/$CODE/gate") || die "projekt '$CODE' neznám, nebo API neodpovědělo"
    printf '%s' "$OUT" | python3 - <<'PY'
import json, sys
d = json.load(sys.stdin)
G, Y, R, D, O = "\033[1;32m", "\033[1;33m", "\033[1;31m", "\033[2m", "\033[0m"
mark = lambda b: f"{G}✓{O}" if b else f"{R}✗{O}"
print(f"\n  Brána před mergem — {d['project']} ({d['repo']})\n")
print(f"  {mark(d['workflow'])} workflow .forgejo/workflows/test.yml v repozitáři")
print(f"  {mark(d['status_check'])} branch protection čeká na status")
print(f"    {D}požaduje{O}  {', '.join(d['required_contexts']) or '—'}")
print(f"    {D}vydáno{O}    {', '.join(d['seen_contexts']) or '— (žádné PR, nebo runner nic nespustil)'}")
print(f"    {D}sedne na{O}  {', '.join(d['matched']) or '—'}")
ap = d.get("required_approvals")
print(f"  {mark(bool(ap))} lidí musí PR odkliknout: {ap if ap is not None else '?'}"
      + ("" if ap else f"  {Y}← kód projde, aniž ho někdo přečetl{O}"))
print(f"  {mark(d['webhook'])} webhook na control plane (bez něj se úkol nepřepne na hotovo)")
col = G if d["ok"] else R
print(f"\n  {col}{d['verdict']}{O}\n")
sys.exit(0 if d["ok"] else 1)
PY
    ;;

  verify)  (cd "$SRC" && ./tools/verify-tree.sh) ;;

  psql)    dc exec -T postgres psql -U agenticdev -d agenticdev "${@:2}" ;;

  kill-switch)
    reason="${2:-ruční zastavení}"
    docker compose -f "$SRC/vps/docker-compose.yml" --env-file "$ENVF" \
      exec -T postgres psql -U agenticdev -d agenticdev -c \
      "UPDATE platform_state SET issuing_enabled=false, reason='$reason', updated_at=now() WHERE id=1"
    echo "✓ vydávání work orderů zastaveno: $reason"
    ;;

  resume)
    docker compose -f "$SRC/vps/docker-compose.yml" --env-file "$ENVF" \
      exec -T postgres psql -U agenticdev -d agenticdev -c \
      "UPDATE platform_state SET issuing_enabled=true, reason=NULL, updated_at=now() WHERE id=1"
    echo "✓ vydávání work orderů obnoveno"
    ;;

  *) cat <<HELP

  agenticdev-ctl — obsluha AgenticDev platformy

    status            co běží, health, otevřené porty
    up | down         start / stop stacku
    restart [služba]  restart
    logs [služba]     živé logy
    pull              stáhne novější image a restartuje

    user add <login> ["Jméno Příjmení"] [e-mail]
                      založí člověku účet na VPS, klíče a registraci
    user list         kdo má na VPS účet
    user pending      kdo se ohlásil a čeká na založení

    mac               vygeneruje instalátor Macu (svázaný s tímhle VPS)
    info              přihlašovací údaje a odkazy
    funnel            (znovu) zapne veřejnou registraci a vypíše odkaz

    smoke             projede platformu end-to-end a řekne, co nesedí
    gate <projekt>    stojí brána před mergem? porovná požadované statusy
                      s těmi, které Forgejo doopravdy vydává
    gate <projekt> --fix   nasadí bránu znovu podle nastavení v panelu
    backup-now        okamžitá záloha
    backup-check      seznam snapshotů
    verify            kontrola stromu repa
    psql [...]        konzole databáze

    kill-switch [důvod]   zastaví vydávání work orderů
    resume                obnoví vydávání

HELP
  ;;
esac
