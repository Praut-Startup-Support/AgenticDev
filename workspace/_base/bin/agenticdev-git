#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════
#  agenticdev-git — git automatizace
#
#  Deterministický nástroj. Žádný model, žádné tokeny.
#  Agent i člověk volají to samé.
#
#  Návrh stojí na třech věcech:
#    1) worktree na úkol → paralelní práce bez stashování
#    2) checkpointy → bisect je pak k něčemu, rewind taky
#    3) git notes → u každého commitu je vidět, ze které session vznikl
# ═══════════════════════════════════════════════════════════════
set -euo pipefail

G='\033[1;32m'; B='\033[1;36m'; Y='\033[1;33m'; R='\033[1;31m'; D='\033[2m'; O='\033[0m'
# Hlášky vždy na stderr. Na stdout jde jen to, co má číst skript.
ok()   { printf "${G}✓${O} %s\n" "$*" >&2; }
info() { printf "${B}▸${O} %s\n" "$*" >&2; }
warn() { printf "${Y}!${O} %s\n" "$*" >&2; }
die()  { printf "${R}✗${O} %s\n" "$*" >&2; exit 1; }

ROOT=$(git rev-parse --show-toplevel 2>/dev/null) || die "Nejsi v git repozitáři."
COMMON=$(git rev-parse --git-common-dir)
MAIN_BRANCH=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|origin/||' || echo main)
# V podu je $ROOT rovno /workspace, takže dirname vyjde na "/" — worktree
# by vznikly uvnitř kontejneru a po teardownu zmizely i s prací.
# Launcher proto podstrčí AGENTICDEV_TREES na adresář připojený z hostitele.
TREES="${AGENTICDEV_TREES:-$(dirname "$ROOT")/.agenticdev-trees}"
SESSION="${PI_SESSION_ID:-${AGENTICDEV_SESSION:-manual}}"
NOTES_REF="refs/notes/agenticdev"

# Přepis diakritiky. Po jednotlivých znacích — třídy znaků rozbíjejí UTF-8.
slug() {
  printf '%s' "$1" | sed \
    -e 's/á/a/g' \
    -e 's/à/a/g' \
    -e 's/â/a/g' \
    -e 's/ä/a/g' \
    -e 's/ã/a/g' \
    -e 's/č/c/g' \
    -e 's/ç/c/g' \
    -e 's/ď/d/g' \
    -e 's/é/e/g' \
    -e 's/ě/e/g' \
    -e 's/è/e/g' \
    -e 's/ê/e/g' \
    -e 's/ë/e/g' \
    -e 's/í/i/g' \
    -e 's/ì/i/g' \
    -e 's/î/i/g' \
    -e 's/ï/i/g' \
    -e 's/ľ/l/g' \
    -e 's/ĺ/l/g' \
    -e 's/ň/n/g' \
    -e 's/ñ/n/g' \
    -e 's/ó/o/g' \
    -e 's/ò/o/g' \
    -e 's/ô/o/g' \
    -e 's/ö/o/g' \
    -e 's/õ/o/g' \
    -e 's/ř/r/g' \
    -e 's/ŕ/r/g' \
    -e 's/š/s/g' \
    -e 's/ś/s/g' \
    -e 's/ť/t/g' \
    -e 's/ú/u/g' \
    -e 's/ů/u/g' \
    -e 's/ù/u/g' \
    -e 's/û/u/g' \
    -e 's/ü/u/g' \
    -e 's/ý/y/g' \
    -e 's/ž/z/g' \
    -e 's/ź/z/g' \
    -e 's/Á/a/g' \
    -e 's/Č/c/g' \
    -e 's/Ď/d/g' \
    -e 's/É/e/g' \
    -e 's/Ě/e/g' \
    -e 's/Í/i/g' \
    -e 's/Ň/n/g' \
    -e 's/Ó/o/g' \
    -e 's/Ř/r/g' \
    -e 's/Š/s/g' \
    -e 's/Ť/t/g' \
    -e 's/Ú/u/g' \
    -e 's/Ů/u/g' \
    -e 's/Ý/y/g' \
    -e 's/Ž/z/g' \
    | tr '[:upper:]' '[:lower:]' \
    | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-*//; s/-*$//' \
    | cut -c1-40
}

# ═══════════════════════════════════════════════════════════════
#  start — nový úkol = nový worktree + větev
# ═══════════════════════════════════════════════════════════════
cmd_start() {
  local desc="${1:?použití: agenticdev-git start \"popis úkolu\" [task-id]}"
  local tid="${2:-}"
  local s; s=$(slug "$desc")
  local branch="task/${tid:+$tid-}$s"
  local wt="$TREES/$s"

  # Celé tělo píše na stderr. Na stdout jde jedině cesta k worktree,
  # aby fungovalo:  cd "$(agenticdev-git start "...")"
  {
    git fetch --quiet origin 2>/dev/null || warn "fetch selhal, jedu z lokálního stavu"

    if git show-ref --quiet "refs/heads/$branch"; then
      info "větev $branch už existuje"
    else
      git branch "$branch" "origin/$MAIN_BRANCH" 2>/dev/null \
        || git branch "$branch" "$MAIN_BRANCH"
    fi

    if [[ -d "$wt" ]]; then
      info "worktree už existuje"
    else
      mkdir -p "$TREES"
      git worktree add --quiet "$wt" "$branch"
    fi

    mkdir -p "$wt/.agenticdev"
    python3 - "$tid" "$desc" "$branch" "$MAIN_BRANCH" "$SESSION" > "$wt/.agenticdev/task.json" <<'PYJSON'
import json, sys, datetime
tid, title, branch, base, session = sys.argv[1:6]
json.dump({"task_id": tid, "title": title, "branch": branch, "base": base,
           "started_at": datetime.datetime.now(datetime.timezone.utc)
                          .strftime("%Y-%m-%dT%H:%M:%SZ"),
           "session": session},
          sys.stdout, ensure_ascii=False, indent=2)
PYJSON

    ok "úkol připraven"
    printf "  větev     %s\n  worktree  %s\n\n" "$branch" "$wt"
  } >&2

  echo "$wt"
}

# ═══════════════════════════════════════════════════════════════
#  checkpoint — průběžný bod návratu
# ═══════════════════════════════════════════════════════════════
cmd_checkpoint() {
  local msg="${1:-průběžný stav}"
  [[ "$(git branch --show-current)" != "$MAIN_BRANCH" ]] \
    || die "Jsi na $MAIN_BRANCH. Nejdřív: agenticdev-git start \"popis\""
  git add -A
  git diff --cached --quiet && { info "nic nového"; return 0; }

  local n; n=$(git log --oneline --grep='^wip(' 2>/dev/null | wc -l | tr -d ' ')
  git commit --quiet -m "wip($((n+1))): $msg" -m "Session: $SESSION"
  git notes --ref="$NOTES_REF" add -f -m "{\"session\":\"$SESSION\",\"kind\":\"checkpoint\",\"ts\":\"$(date -u +%FT%TZ)\"}" HEAD
  ok "checkpoint #$((n+1)) — $msg"
}

# ═══════════════════════════════════════════════════════════════
#  save — pořádný commit podle Conventional Commits
# ═══════════════════════════════════════════════════════════════
cmd_save() {
  local type="${1:?použití: agenticdev-git save <feat|fix|refactor|test|docs|chore> <scope> \"zpráva\"}"
  local scope="${2:?chybí scope}"
  local msg="${3:?chybí zpráva}"
  case "$type" in
    feat|fix|refactor|test|docs|chore|perf|build|ci) ;;
    *) die "neznámý typ '$type'" ;;
  esac

  [[ "$(git branch --show-current)" != "$MAIN_BRANCH" ]] \
    || die "Jsi na $MAIN_BRANCH. Nejdřív: agenticdev-git start \"popis\""
  git add -A
  git diff --cached --quiet && { info "nic k uložení"; return 0; }

  local tid=""
  [[ -f .agenticdev/task.json ]] && tid=$(python3 -c 'import json;print(json.load(open(".agenticdev/task.json")).get("task_id",""))' 2>/dev/null || true)

  git commit --quiet -m "$type($scope): $msg" \
    -m "${tid:+Task-Id: $tid}" -m "Session: $SESSION"
  git notes --ref="$NOTES_REF" add -f \
    -m "{\"session\":\"$SESSION\",\"kind\":\"$type\",\"ts\":\"$(date -u +%FT%TZ)\"}" HEAD
  ok "$type($scope): $msg"
}

# ═══════════════════════════════════════════════════════════════
#  sync — narovnání na main
# ═══════════════════════════════════════════════════════════════
cmd_sync() {
  local manual=0
  [[ "${1:-}" == "--manual" ]] && manual=1

  git fetch --quiet origin || die "fetch selhal"
  local behind; behind=$(git rev-list --count "HEAD..origin/$MAIN_BRANCH" 2>/dev/null || echo 0)
  [[ "$behind" -eq 0 ]] && { ok "jsi aktuální"; return 0; }

  info "$behind commitů pozadu, rebasuju"
  if ! git rebase --quiet "origin/$MAIN_BRANCH"; then
    local files; files=$(git --no-pager diff --name-only --diff-filter=U | sort -u)

    if [[ "$manual" -eq 1 ]]; then
      warn "konflikt při rebase — nechávám ho rozdělaný, jak jsi chtěl"
      printf '%s\n' "$files" | sed 's/^/    /'
      echo
      echo "  Vyřeš, pak: git rebase --continue"
      echo "  Nebo zruš:  git rebase --abort"
      return 1
    fi

    # Výchozí chování je pro člověka, který git neumí. Rozdělaný rebase je
    # pro něj slepá ulička: nezná --continue, nezná --abort, a co udělá
    # naslepo, o práci připraví. Vrátíme ho tedy tam, kde byl — commity na
    # větvi zůstávají — a konflikt předáme dál jako rozhodnutí pro člověka.
    # Kdo git umí, dostane tu původní cestu přes `sync --manual`.
    git rebase --abort 2>/dev/null || true
    warn "konflikt s $MAIN_BRANCH — tvoje práce zůstala, jak byla"
    echo
    echo "  Někdo změnil stejná místa dřív než ty:"
    printf '%s\n' "$files" | sed 's/^/    /'
    echo
    echo "  Nic se neztratilo. Commity máš na větvi $(git branch --show-current)."
    echo "  Tohle už není práce pro agenta — musí to srovnat člověk."

    if command -v agenticdev-decision >/dev/null 2>&1 && [[ -n "${AGENTICDEV_CP:-}" ]]; then
      if agenticdev-decision \
           "Konflikt s $MAIN_BRANCH na větvi $(git branch --show-current)" \
           "čeká na člověka" \
           "Kolidující soubory: $(printf '%s' "$files" | tr '\n' ' ')" >/dev/null 2>&1; then
        ok "zapsáno na VPS — objeví se to v panelu"
      else
        info "na VPS se to zapsat nepovedlo, řekni to člověku sám"
      fi
    fi
    printf "\n  ${D}Kdo umí git: agenticdev-git sync --manual${O}\n" >&2
    return 1
  fi
  ok "narovnáno na $MAIN_BRANCH"
}

# ═══════════════════════════════════════════════════════════════
#  finish — sesypat wip, narovnat, poslat, otevřít PR
# ═══════════════════════════════════════════════════════════════
cmd_finish() {
  local title="${1:-}"
  local branch; branch=$(git branch --show-current)
  [[ "$branch" != "$MAIN_BRANCH" ]] || die "Jsi na $MAIN_BRANCH. Nic neodesílám."

  git diff --quiet && git diff --cached --quiet || {
    warn "máš nezacommitované změny"; cmd_checkpoint "před odevzdáním"; }

  # wip commity sesypat do jednoho
  local wips; wips=$(git log --oneline "origin/$MAIN_BRANCH..HEAD" --grep='^wip(' | wc -l | tr -d ' ')
  if [[ "$wips" -gt 0 ]]; then
    info "sesypávám $wips checkpointů"
    local base; base=$(git merge-base HEAD "origin/$MAIN_BRANCH")
    # grep nemusí nic najít (všechno jsou wip) — bez || true by pipefail shodil skript
    local msg; msg=$(git log --format='%s' "$base..HEAD" | grep -v '^wip(' | head -1 || true)
    [[ -n "$title" ]] && msg="$title"
    [[ -n "$msg" ]] || msg="feat: $(basename "$branch" | sed 's|^task/[^-]*-||; s/-/ /g')"
    git reset --soft "$base"
    git commit --quiet -m "$msg" -m "Session: $SESSION"
    # note se sesypáním ztratí, znovu ji připnout na nový commit
    git notes --ref="$NOTES_REF" add -f \
      -m "{\"session\":\"$SESSION\",\"kind\":\"squashed\",\"checkpoints\":$wips,\"ts\":\"$(date -u +%FT%TZ)\"}" HEAD
  fi

  # Konflikt neobcházíme: větev, která se nedá narovnat, se neodesílá.
  # `sync` už člověka informoval a konflikt zapsal, tady jen nepokračujeme.
  cmd_sync || die "Neodevzdávám — nejdřív se musí vyřešit ten konflikt."

  # Odsud dál to není práce podu. Síťový git a zakládání PR dělá hostitel:
  # agent nemá přístup k repozitáři ani token do Forgeja, a to je záměr —
  # kdyby je měl, přestalo by platit to, co o platformě tvrdíme.
  #
  # Necháme tu jen vzkaz. Launcher ho po ukončení podu najde, větev odešle
  # a požádá control plane, ať otevře PR.
  local tid=""
  [[ -f .agenticdev/task.json ]] && tid=$(python3 -c \
    'import json;print(json.load(open(".agenticdev/task.json")).get("task_id",""))' \
    2>/dev/null || true)

  local subjects; subjects=$(git log --format='- %s' "origin/$MAIN_BRANCH..HEAD" 2>/dev/null || true)
  # Tělo jde argumentem, ne rourou: stdin patří heredocu se skriptem.
  python3 - "$branch" "$MAIN_BRANCH" "${title:-$branch}" "$tid" "$SESSION" "$subjects" \
    > .agenticdev/finished <<'PYJSON'
import json, sys
branch, base, title, task_id, session, body = sys.argv[1:7]
json.dump({"branch": branch, "base": base, "title": title,
           "task_id": task_id, "session": session, "body": body},
          sys.stdout, ensure_ascii=False, indent=2)
PYJSON

  ok "hotovo — připraveno k odeslání"
  info "větev $branch odešle a PR otevře launcher, až pod skončí"
}

# ═══════════════════════════════════════════════════════════════
#  park / switch / list — přepínání mezi úkoly
# ═══════════════════════════════════════════════════════════════
cmd_park()  { cmd_checkpoint "odloženo"; ok "odloženo, můžeš přepnout jinam"; }

cmd_list() {
  printf "\n  ${B}Rozdělané úkoly${O}\n\n"
  local here; here=$(git rev-parse --show-toplevel)
  git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch /{print w"\t"$2}' | \
  while IFS=$'\t' read -r w b; do
    b=${b#refs/heads/}
    [[ "$b" == "$MAIN_BRANCH" ]] && continue
    n=$(git -C "$w" log --oneline "origin/$MAIN_BRANCH..HEAD" 2>/dev/null | wc -l | tr -d ' ')
    dirty=""; git -C "$w" diff --quiet 2>/dev/null || dirty=" ${Y}*neuloženo${O}"
    mark="  "; [[ "$w" == "$here" ]] && mark="${G}→ ${O}"
    printf "  %b%-32s ${D}%s commitů${O}%b\n" "$mark" "$b" "$n" "$dirty"
  done
  echo
}

cmd_switch() {
  local q="${1:?použití: agenticdev-git switch <část-názvu>}"
  local w; w=$(git worktree list --porcelain | awk '/^worktree /{print $2}' | grep -i "$q" | head -1)
  [[ -n "$w" ]] || die "worktree '$q' nenalezen (agenticdev-git list)"
  echo "$w"
}

# ═══════════════════════════════════════════════════════════════
#  who — kdo napsal tenhle řádek a v jaké session
# ═══════════════════════════════════════════════════════════════
cmd_who() {
  local f="${1:?použití: agenticdev-git who <soubor> [řádek]}"
  local ln="${2:-}"
  local sha
  if [[ -n "$ln" ]]; then
    sha=$(git blame -L "$ln,$ln" --porcelain -- "$f" | head -1 | cut -d' ' -f1)
  else
    sha=$(git log -1 --format=%H -- "$f")
  fi
  printf "\n  commit   %s\n" "${sha:0:12}"
  printf "  zpráva   %s\n" "$(git log -1 --format=%s "$sha")"
  printf "  autor    %s\n" "$(git log -1 --format='%an <%ae>' "$sha")"
  printf "  session  %s\n\n" \
    "$(git notes --ref="$NOTES_REF" show "$sha" 2>/dev/null | python3 -c 'import json,sys;print(json.load(sys.stdin).get("session","-"))' 2>/dev/null || echo '-')"
}

# ═══════════════════════════════════════════════════════════════
#  cleanup — uklidit dokončené
# ═══════════════════════════════════════════════════════════════
cmd_cleanup() {
  git fetch --quiet --prune origin
  git worktree list --porcelain | awk '/^worktree /{w=$2} /^branch /{print w"\t"$2}' | \
  while IFS=$'\t' read -r w b; do
    b=${b#refs/heads/}
    [[ "$b" == "$MAIN_BRANCH" ]] && continue
    if git merge-base --is-ancestor "$b" "origin/$MAIN_BRANCH" 2>/dev/null; then
      info "smergováno: $b"
      git worktree remove --force "$w" 2>/dev/null || true
      git branch -D "$b" 2>/dev/null || true
    fi
  done
  git worktree prune
  ok "uklizeno"
}

case "${1:-help}" in
  start)      shift; cmd_start "$@" ;;
  checkpoint|cp) shift; cmd_checkpoint "$@" ;;
  save)       shift; cmd_save "$@" ;;
  sync)       shift; cmd_sync "$@" ;;
  finish)     shift; cmd_finish "$@" ;;
  park)       cmd_park ;;
  list|ls)    cmd_list ;;
  switch)     shift; cmd_switch "$@" ;;
  who)        shift; cmd_who "$@" ;;
  cleanup)    cmd_cleanup ;;
  *) cat <<'HELP'
agenticdev-git — git automatizace

  start "popis" [id]   nový worktree + větev z main
  checkpoint [zpráva]  průběžný bod návratu (wip commit)
  save <typ> <scope> "zpráva"
                       pořádný commit (feat|fix|refactor|test|docs|chore)
  sync [--manual]      rebase na aktuální main
                       konflikt: vrátí stav a předá člověku
                       --manual = nechá rozdělaný rebase (pro znalce gitu)
  finish ["titulek"]   sesype wip, narovná; odeslat a PR otevřít
                       už je práce launcheru na VPS
  park                 odloží rozdělanou práci
  list                 rozdělané úkoly
  switch <část>        cesta k worktree
  who <soubor> [řádek] kdo a v jaké session to napsal
  cleanup              smaže smergované větve a worktrees
HELP
  ;;
esac
